--- a/src/gagmap.c
+++ b/src/gagmap.c
@@ -2468,9 +2468,14 @@
 //$$$
 {
       g2int  ret;
-      g2int k,k4,nread,lim,start,vers,lengrib;
+      g2int k,k4,nread,lim;
       off_t ipos;
       int    end;
+#ifdef G2C_VERSION
+      int    start,vers,lengrib;
+#else
+      g2int  start,vers,lengrib;
+#endif
       unsigned char *cbuf;
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
@@ -2493,12 +2498,22 @@
 //  LOOK FOR 'GRIB...' IN PARTIAL SECTION
 
         for (k=0;k<lim;k++) {
+#ifdef G2C_VERSION
+          g2c_gbit_int(cbuf,&start,(k+0)*8,4*8);
+          g2c_gbit_int(cbuf,&vers,(k+7)*8,1*8);
+#else
           gbit(cbuf,&start,(k+0)*8,4*8);
           gbit(cbuf,&vers,(k+7)*8,1*8);
+#endif
           if (start==1196575042 && (vers==1 || vers==2)) {
 //  LOOK FOR '7777' AT END OF GRIB MESSAGE
+#ifdef G2C_VERSION
+            if (vers == 1) g2c_gbit_int(cbuf,&lengrib,(k+4)*8,3*8);
+            if (vers == 2) g2c_gbit_int(cbuf,&lengrib,(k+12)*8,4*8);
+#else
             if (vers == 1) gbit(cbuf,&lengrib,(k+4)*8,3*8);
             if (vers == 2) gbit(cbuf,&lengrib,(k+12)*8,4*8);
+#endif
             ret=fseeko(lugb,ipos+(off_t)(k+lengrib-4),SEEK_SET);
 //          Hard code to 4 instead of sizeof(g2int)
             k4=fread(&end,4,1,lugb);
