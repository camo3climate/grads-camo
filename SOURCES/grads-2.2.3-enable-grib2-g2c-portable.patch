--- a/src/gacfg.c
+++ b/src/gacfg.c
@@ -141,7 +141,13 @@
 #endif
 
 #if GRIB2==1
+#ifdef G2C_VERSION
+   snprintf(cmd,255,"  +  GRIB2 interface ENABLED  %s \n",G2C_VERSION);
+#elif defined(G2_VERSION)
    snprintf(cmd,255,"  +  GRIB2 interface ENABLED  %s \n",G2_VERSION);
+#else
+   snprintf(cmd,255,"  +  GRIB2 interface ENABLED\n");
