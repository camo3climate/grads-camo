+
+  if (dlon<=0.0 || dlat<=0.0 || nx<1 || ny<1) {
+    gaprnt(0,"Error from RE: invalid output grid size or increment\n");
+    gafree(pst);
+    return(1);
+  }
+
+  if (gare_parse_re_methods(pfc,method_start,&opt,&bessel,&minpct,&method_set)) {
+    gafree(pst);
+    return(1);
+  }
+  if (!method_set) {
+    if (src->isiz<2 || src->jsiz<2) {
+      gaprnt(0,"Error from RE: input grid must have at least two points in lon and lat for default method selection\n");
+      gafree(pst);
+      return(1);
+    }
+    srcdx = fabs(src->igrab(src->ivals,(gadouble)(src->dimmin[0]+1)) -
+                 src->igrab(src->ivals,(gadouble)src->dimmin[0]));
+    srcdy = fabs(src->jgrab(src->jvals,(gadouble)(src->dimmin[1]+1)) -
+                 src->jgrab(src->jvals,(gadouble)src->dimmin[1]));
+    if (dlon>=srcdx || dlat>=srcdy) { opt=1; bessel=0; }
+    else { opt=0; bessel=1; }
+  }
+
+  dx = dlon;
+  dy = dlat;
+  dst = gare_make_re_dest(src,nx,xstart,dx,ny,ystart,dy);
+  if (dst==NULL) {
+    gaprnt(0,"Error from RE: unable to allocate destination grid\n");
+    gafree(pst);
+    return(1);
+  }
+
+  rc = galterp_core(src,dst,opt,bessel,minpct);
+  if (rc) {
+    gagfre(dst);
+    gafree(pst);
+    return(1);
+  }
+  gagfre(src);
+  pst->result.pgr = dst;
+  pst->type = 1;
+  return(0);
 }
 
