+static gadouble *gare_make_linear_axis (gadouble start, gadouble incr, char *tag) {
+gadouble *vals;
+
+  vals = (gadouble *)galloc(sizeof(gadouble)*6,tag);
+  if (vals==NULL) return(NULL);
+  *(vals)   = incr;
+  *(vals+1) = start - incr;
+  *(vals+2) = -999.9;
+  *(vals+3) = 1.0/incr;
+  *(vals+4) = -1.0 * ((start-incr)/incr);
+  *(vals+5) = -999.9;
+  return(vals);
+}
 
