+gaint ffre (struct gafunc *pfc, struct gastat *pst) {
+struct gagrid *src=NULL,*dst=NULL;
+gadouble dlon,dlat,xstart=0.0,ystart=0.0,dx,dy,srcdx,srcdy;
+gadouble lon1,lon2,lat1,lat2;
+gaint nx=0,ny=0,opt=0,bessel=0,method_set=0,method_start=0,rc;
+char tok[32];
+gadouble minpct=50.0;
+
+  if (pfc->argnum<2) {
+    gaprnt(0,"Error from RE: too few arguments\n");
+    gaprnt(0,"  Usage: re(expr,dlon[,dlat][,bl|bs|ba|ma,fraction])\n");
+    return(1);
+  }
+
+  rc = gaexpr(pfc->argpnt[0],pst);
+  if (rc) return(rc);
+  if (pst->type!=1 || pst->result.pgr==NULL) {
+    gaprnt(0,"Error from RE: first argument must be a grid expression\n");
+    gafree(pst);
+    return(1);
+  }
+  src = pst->result.pgr;
+  if (src->idim!=0 || src->jdim!=1) {
+    gaprnt(0,"Error from RE: CAMO limited re() requires a 2-D lon/lat grid\n");
+    gafree(pst);
+    return(1);
+  }
+
+  if (pfc->argnum>=9) {
+    gare_clean_token(pfc->argpnt[2],tok,sizeof(tok));
+    if (strcmp(tok,"linear")) {
+      gaprnt(0,"Error from RE: CAMO limited re() supports only linear X output mapping\n");
+      gafree(pst);
+      return(1);
+    }
+    gare_clean_token(pfc->argpnt[6],tok,sizeof(tok));
+    if (strcmp(tok,"linear")) {
+      gaprnt(0,"Error from RE: CAMO limited re() supports only linear Y output mapping\n");
+      gafree(pst);
+      return(1);
+    }
+    if (gare_parse_int_arg(pfc->argpnt[1],&nx) || getdbl(pfc->argpnt[3],&xstart)==NULL ||
+        getdbl(pfc->argpnt[4],&dlon)==NULL || gare_parse_int_arg(pfc->argpnt[5],&ny) ||
+        getdbl(pfc->argpnt[7],&ystart)==NULL || getdbl(pfc->argpnt[8],&dlat)==NULL) {
+      gaprnt(0,"Error from RE: invalid full-grid arguments\n");
+      gafree(pst);
+      return(1);
+    }
+    method_start = 9;
+  }
+  else {
+    if (getdbl(pfc->argpnt[1],&dlon)==NULL) {
+      gaprnt(0,"Error from RE: dlon must be numeric\n");
+      gafree(pst);
+      return(1);
+    }
+    if (pfc->argnum>=3 && !gare_is_method_token(pfc->argpnt[2])) {
+      if (getdbl(pfc->argpnt[2],&dlat)==NULL) {
+        gaprnt(0,"Error from RE: dlat must be numeric\n");
+        gafree(pst);
+        return(1);
+      }
+      method_start = 3;
+    }
+    else {
+      dlat = dlon;
+      method_start = 2;
+    }
+    lon1 = pst->dmin[0]; lon2 = pst->dmax[0];
+    lat1 = pst->dmin[1]; lat2 = pst->dmax[1];
+    if (gare_shorthand_axis(lon1,lon2,dlon,1,&nx,&xstart) ||
+        gare_shorthand_axis(lat1,lat2,dlat,0,&ny,&ystart)) {
+      gaprnt(0,"Error from RE: unable to derive output grid from current lon/lat environment\n");
+      gafree(pst);
+      return(1);
+    }
