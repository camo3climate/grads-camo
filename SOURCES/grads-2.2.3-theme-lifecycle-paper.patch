+/* Commands lazily initialize these pointers, but startup applies a theme
+   before the first command. Obtain the already-loaded backends here too. */
+static void gacamo_theme_font (void) {
+  if (dsubs==NULL) dsubs = getdsubs();
+  if (psubs==NULL) psubs = getpsubs();
+  if (dsubs && psubs && dsubs->gxdckfont && psubs->gxpckfont &&
+      dsubs->gxdckfont()!=0 && psubs->gxpckfont()!=0) gxdbsethersh(1);
+  else gxdbsethersh(0);    /* Hershey fallback needs no system font library. */
+  gxchdf(0);
+}
+
+/* One silent implementation for startup, reset/reinit and explicit modern.
+   The output type is set by startup/reset, not by an explicit theme command. */
+gaint gacamo_apply_modern_defaults (struct gacmn *pcm) {
+gaint i,p,npal;
+
+  if (pcm==NULL) return(1);
+  gxsetllasp(1.0);
+  gacamo_theme_font();
+  pcm->grflag = 1;
+  pcm->grstyl = 1;
+  pcm->grcolr = 15;
+  pcm->grthck = 1;
+  pcm->mapcol = 15;
+  pcm->mapstl = 1;
+  pcm->mapthk = 2;
+  pcm->aaflg = 1;
+  gxsignal(3);
+
+  p = -1;
+  npal = sizeof(palettes) / sizeof(palettes[0]);
+  for (i=0; i<npal; i++) {
+    if (cmpwrdl("cividis",(char *)palettes[i].key)) p = i;
+  }
+  if (p<0) return(1);
+  for (i=0; i<CAMO_RGBMAP_COLORS; i++) {
+    gxacol(16+i, palettes[p].red[i], palettes[p].green[i], palettes[p].blue[i], 255);
+    pcm->rbcols[i] = 16+i;
+  }
+  pcm->rbflg = CAMO_RGBMAP_COLORS;
+  return(0);
+}
