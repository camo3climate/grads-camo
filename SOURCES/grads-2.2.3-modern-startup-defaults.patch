Description: use CAMO modern display defaults at startup
Author: CAMO packaging maintainers
Forwarded: no
Last-Update: 2026-07-05

--- grads-2.2.3/src/camo_colormap_impl.inc
+++ grads-2.2.3/src/camo_colormap_impl.inc
@@ -202,3 +202,37 @@
   gaprnt(0,"SET THEME Error: valid themes are classic or modern\n");
   return(1);
 }
+
+gaint gacamo_apply_modern_defaults (struct gacmn *pcm) {
+gaint i,j,p,npal;
+
+  if (pcm==NULL) return(1);
+  gxsetllasp(1.0);
+  if (dsubs && psubs && dsubs->gxdckfont()!=0 && psubs->gxpckfont()!=0) {
+    gxdbsethersh(1);
+    gxchdf(0);
+  }
+  pcm->grflag = 1;
+  pcm->grstyl = 1;
+  pcm->grcolr = 15;
+  pcm->grthck = 1;
+  pcm->mapcol = 15;
+  pcm->mapstl = 1;
+  pcm->mapthk = 2;
+  pcm->aaflg = 1;
+  gxsignal(3);
+
+  p = -1;
+  npal = sizeof(palettes) / sizeof(palettes[0]);
+  for (i=0; i<npal; i++) {
+    if (cmpwrdl("cividis",(char *)palettes[i].key)) p = i;
+  }
+  if (p<0) return(1);
+  for (i=0; i<CAMO_RGBMAP_COLORS; i++) {
+    j = i;
+    gxacol(16+i, palettes[p].red[j], palettes[p].green[j], palettes[p].blue[j], 255);
+    pcm->rbcols[i] = 16+i;
+  }
+  pcm->rbflg = CAMO_RGBMAP_COLORS;
+  return(0);
+}
+
--- grads-2.2.3/src/grads.c
+++ grads-2.2.3/src/grads.c
@@ -57,6 +57,7 @@
   void gxdgeo (char *);
   void gxend (void);
   void gatxti(gaint on, gaint cs);
+  gaint gacamo_apply_modern_defaults(struct gacmn *pcm);
   char *gatxtl(char *str,gaint level);
   
   char cmd[1024];
@@ -312,6 +313,10 @@
   rc=gagx(&gcmn);
   if (rc) exit(rc);
 
+  /* CAMO defaults favor modern rendering while preserving user overrides. */
+  gacamo_apply_modern_defaults(&gcmn);
+  gcmn.gout2a = 16;
+
   /* Inform gaio.c what the global scale factor for netcdf4/hdf5 cache */
   setcachesf(gcmn.cachesf);
 
