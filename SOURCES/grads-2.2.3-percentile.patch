+
+
+/* Return a percentile over one grid dimension.  Missing values are
+   omitted and the result uses linear interpolation between adjacent
+   order statistics (Hyndman and Fan type 7). */
+
+static int pctlcmp (const void *a, const void *b) {
+gadouble aa,bb;
+
+  aa = *(const gadouble *)a;
+  bb = *(const gadouble *)b;
+  if (aa < bb) return (-1);
+  if (aa > bb) return (1);
+  return (0);
+}
+
+/* dimprs expects a closing ')' after an ensemble name. Function arguments
+   are separate NUL-terminated strings, so resolve names without that scan. */
+static char *pctldim (char *arg, struct gastat *pst, struct gafile *pfi,
+                     gaint *dim, gadouble *grid, gaint *wflag) {
+gaint i;
+  if (strncmp(arg,"ens",3)!=0)
+    return dimprs(arg,pst,pfi,dim,grid,1,wflag);
+  if (strncmp(arg,"ens=",4)!=0 || pfi->ens1==NULL) return NULL;
+  for (i=0; i<pfi->dnum[4]; i++) {
+    if (strcmp(arg+4,pfi->ens1[i].name)==0) {
+      *dim = 4;
+      *grid = (gadouble)i+1.0+pfi->dimoff[4];
+      *wflag = 1;
+      return arg+strlen(arg);
+    }
+  }
+  return NULL;
+}
+
+gaint ffpctl (struct gafunc *pfc, struct gastat *pst) {
+struct gafile *pfi;
+struct gagrid *pgr=NULL,*pgr1=NULL;
+gadouble (*conv) (gadouble *, gadouble);
+gadouble gr1=0.0,gr2=0.0,pct,abs,pos,frac,mos,mns,steps;
+gadouble *samples=NULL,*scratch=NULL;
+char *ch,*end,*masks=NULL;
+gaint dim=-1,dim2=-1,wflag=0,d1,d2,d,incr=1,rc=0;
+long count;
+size_t i,s,nsamp,siz,total,nvalid,lo,hi;
+
+  if (pfc->argnum<4 || pfc->argnum>5) {
+    gaprnt (0,"Error from PERCENTILE: Too many or too few args\n");
+    gaprnt (0,"                       4 or 5 arguments expected\n");
+    return (1);
+  }
+
+  pfi = pst->pfid;
+  if (pfi==NULL || (pfi->type!=1 && pfi->type!=4 && pfi->type!=5)) {
+    gaprnt (0,"Error from PERCENTILE: a gridded default file is required\n");
+    return (1);
+  }
+  ch = pctldim (pfc->argpnt[1],pst,pfi,&dim,&gr1,&wflag);
+  if (ch==NULL || *ch!='\0' || !isfinite(gr1) || wflag==2) {
+    gaprnt (0,"Error from PERCENTILE: 1st dimension expression invalid\n");
+    if (wflag==2)
+      gaprnt (0,"  offt expression not supported as an arg to PERCENTILE\n");
+    return (1);
+  }
+
+  wflag = 0;
+  ch = pctldim (pfc->argpnt[2],pst,pfi,&dim2,&gr2,&wflag);
+  if (ch==NULL || *ch!='\0' || !isfinite(gr2) ||
+      dim2!=dim || gr2<gr1 || wflag==2) {
+    gaprnt (0,"Error from PERCENTILE: 2nd dimension expression invalid\n");
+    if (dim2!=dim)
+      gaprnt (0,"  start and end points have different dimensions\n");
+    if (gr2<gr1)
+      gaprnt (0,"  end grid point is less than start grid point\n");
+    if (wflag==2)
+      gaprnt (0,"  offt expression not supported as an arg to PERCENTILE\n");
+    return (1);
+  }
+
+  end = getdbl(pfc->argpnt[3],&pct);
+  if (end==NULL || *end!='\0' || !isfinite(pct) || pct<0.0 || pct>100.0) {
+    gaprnt (0,"Error from PERCENTILE: percentile must be between 0 and 100\n");
+    return (1);
+  }
+
+  if (pfc->argnum==5) {
+    if (dim!=3) {
+      gaprnt (0,"Error from PERCENTILE: increment is valid only for time\n");
+      return (1);
+    }
+    /* Parse bounded integers before any arithmetic. The older intprs /
+       rdtprs helpers can overflow on an excessively long input. */
+    ch = pfc->argpnt[4];
+    errno = 0;
+    count = strtol(ch,&end,10);
+    if (end==ch || errno==ERANGE || count<1 || count>INT_MAX) goto incerr;
+    if (*end=='\0') incr = (gaint)count;
+    else {
+      mos = mns = 0.0;
+      while (*ch) {
+        if (*ch<'0' || *ch>'9') goto incerr;
+        errno = 0;
+        count = strtol(ch,&end,10);
+        if (errno==ERANGE || count>INT_MAX) goto incerr;
+        if (strncmp(end,"yr",2)==0) mos += 12.0*count;
+        else if (strncmp(end,"mo",2)==0) mos += count;
+        else if (strncmp(end,"dy",2)==0) mns += 1440.0*count;
+        else if (strncmp(end,"hr",2)==0) mns += 60.0*count;
+        else if (strncmp(end,"mn",2)==0) mns += count;
+        else goto incerr;
+        ch = end+2;
+      }
+      /* A mixed calendar/fixed-length increment is ambiguous. */
+      if (mos>0.0 && mns>0.0) goto incerr;
+      if (mos>0.0 && *(pfi->grvals[3]+5)>0.0)
+        steps = mos / (*(pfi->grvals[3]+5));
+      else if (mns>0.0 && *(pfi->grvals[3]+6)>0.0)
+        steps = mns / (*(pfi->grvals[3]+6));
+      else goto incerr;
+      if (steps<1.0 || steps>INT_MAX || steps!=floor(steps)) goto incerr;
+      incr = (gaint)steps;
+    }
+    if (incr<1) goto incerr;
+  }
+
+  if (pst->idim==dim) {
+    pst->idim = pst->jdim;
+    pst->jdim = -1;
+  }
+  if (pst->jdim==dim) pst->jdim = -1;
+  gr1 = ceil(gr1-0.001);
+  gr2 = floor(gr2+0.001);
+  if (gr1<INT_MIN || gr1>INT_MAX || gr2<INT_MIN || gr2>INT_MAX) {
+    gaprnt (0,"Error from PERCENTILE: grid coordinate is out of range\n");
+    return (1);
+  }
+  d1 = (gaint)gr1;
+  d2 = (gaint)gr2;
+  if (d2<d1) {
+    gaprnt (0,"Error from PERCENTILE: dimension range contains no grid points\n");
+    return (1);
+  }
+  steps = floor((gr2-gr1)/incr)+1.0;
+  if (steps>(gadouble)((size_t)-1)) {
+    gaprnt (0,"Error from PERCENTILE: too many samples\n");
+    return (1);
+  }
+  nsamp = (size_t)steps;
+
+  if (mfcmn.warnflg > 0) {
+    snprintf(pout,1255,
+             "PERCENTILE: dim = %i, start = %i, end = %i, pct = %g\n",
+             dim,d1,d2,pct);
+    gaprnt (2,pout);
+  }
+
+  d = d1;
+  for (s=0; s<nsamp; s++) {
+    if (dim==3) {
+      gr2t (pfi->grvals[3],d,&(pst->tmin));
+      pst->tmax = pst->tmin;
+    }
+    else {
+      conv = pfi->gr2ab[dim];
+      abs = conv(pfi->grvals[dim],d);
+      pst->dmin[dim] = abs;
+      pst->dmax[dim] = abs;
+    }
+
+    rc = gaexpr(pfc->argpnt[0],pst);
+    if (rc) goto exprerr;
+    if (pst->type==0) {
+      gafree(pst);
+      rc = -1;
+      goto exprerr;
+    }
+    pgr = pst->result.pgr;
+
+    if (s==0) {
+      pgr1 = pgr;
+      if (pgr1->isiz<1 || pgr1->jsiz<1 ||
+          (size_t)pgr1->isiz>((size_t)-1)/(size_t)pgr1->jsiz) {
+        gaprnt (0,"Error from PERCENTILE: invalid grid size\n");
+        goto memerr;
+      }
+      siz = (size_t)pgr1->isiz * (size_t)pgr1->jsiz;
+      if (siz==0 || nsamp>((size_t)-1)/siz ||
+          nsamp*siz>((size_t)-1)/sizeof(gadouble)) {
+        gaprnt (0,"Error from PERCENTILE: requested result is too large\n");
+        goto memerr;
+      }
+      total = nsamp*siz;
+      samples = (gadouble *)galloc(total*sizeof(gadouble),"pctlsamples");
+      masks = (char *)galloc(total*sizeof(char),"pctlmasks");
+      scratch = (gadouble *)galloc(nsamp*sizeof(gadouble),"pctlscratch");
+      if (samples==NULL || masks==NULL || scratch==NULL) {
+        gaprnt (0,"Error from PERCENTILE: memory allocation failed\n");
+        goto memerr;
+      }
+    }
+    else if (pgr->isiz!=pgr1->isiz || pgr->jsiz!=pgr1->jsiz ||
+             pgr->idim!=pgr1->idim || pgr->jdim!=pgr1->jdim ||
+             gagchk(pgr1,pgr,pgr1->idim) || gagchk(pgr1,pgr,pgr1->jdim)) {
+      gaprnt (0,"Error from PERCENTILE: expression grids do not match\n");
+      gagfre(pgr);
+      goto memerr;
+    }
+
+    for (i=0; i<siz; i++) {
+      masks[s*siz+i] = pgr->umask[i] && isfinite(pgr->grid[i]);
+      samples[s*siz+i] = masks[s*siz+i] ? pgr->grid[i] : 0.0;
+    }
+    if (s>0) gagfre(pgr);
+    /* Do not increment after the last sample: d2 may be INT_MAX. */
+    if (s+1<nsamp) d += incr;
+  }
+
+  for (i=0; i<siz; i++) {
+    nvalid = 0;
+    for (s=0; s<nsamp; s++) {
+      if (masks[s*siz+i]) scratch[nvalid++] = samples[s*siz+i];
+    }
+    if (nvalid==0) {
+      pgr1->umask[i] = 0;
+    }
+    else {
+      qsort(scratch,nvalid,sizeof(gadouble),pctlcmp);
+      pos = ((gadouble)nvalid-1.0)*pct/100.0;
+      lo = (size_t)floor(pos);
+      hi = (size_t)ceil(pos);
+      frac = pos-(gadouble)lo;
+      if (lo==hi) pgr1->grid[i] = scratch[lo];
+      else if (scratch[lo]<0.0 && scratch[hi]>0.0)
+        pgr1->grid[i] = (1.0-frac)*scratch[lo] + frac*scratch[hi];
+      else pgr1->grid[i] = scratch[lo] + frac*(scratch[hi]-scratch[lo]);
+      pgr1->umask[i] = 1;
+    }
+  }
+
+  gree(samples,"pctlsamples");
+  gree(masks,"pctlmasks");
+  gree(scratch,"pctlscratch");
+  pst->type = 1;
+  pst->result.pgr = pgr1;
+  return (0);
+
+incerr:
+  gaprnt (0,"Error from PERCENTILE: invalid time increment argument\n");
   return (1);
+
+memerr:
+  if (samples) gree(samples,"pctlsamples");
+  if (masks) gree(masks,"pctlmasks");
+  if (scratch) gree(scratch,"pctlscratch");
+  if (pgr1) gagfre(pgr1);
+  return (1);
+
+exprerr:
+  if (samples) gree(samples,"pctlsamples");
+  if (masks) gree(masks,"pctlmasks");
+  if (scratch) gree(scratch,"pctlscratch");
+  if (pgr1) gagfre(pgr1);
+  gaprnt (0,"Error from PERCENTILE: error getting grids\n");
+  return (rc);
 }
 
 
