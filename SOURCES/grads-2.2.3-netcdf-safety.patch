+        snprintf(pout,1255,"Warning: SDF attribute %s:%s has unsupported type %d; ignored\n",
+                 varname,attname,type);
+        gaprnt(1,pout);
+        continue;
+    }
+    /* gaattr.len is an int; check it as well as the allocation product. */
+    if (length < count || length > INT_MAX || length > (size_t)-1 / width)
+      goto nomem;
+    bytes = length * width;
+    value = galloc(bytes,"ncattribute");
+    if (!value) goto nomem;
+    switch (type) {
+      case NC_BYTE: status = nc_get_att_schar(cdfid,varid,attname,value); break;
+      case NC_CHAR:
+        status = nc_get_att_text(cdfid,varid,attname,value);
+        ((char*)value)[count] = '\0';
+        break;
+      case NC_SHORT: status = nc_get_att_short(cdfid,varid,attname,value); break;
+      case NC_INT: status = nc_get_att_int(cdfid,varid,attname,value); break;
+      case NC_FLOAT: status = nc_get_att_float(cdfid,varid,attname,value); break;
+      case NC_STRING:
+        strings = value;
+        value = NULL;
+        memset(strings,0,bytes);
+        status = nc_get_att_string(cdfid,varid,attname,strings);
+        if (status != NC_NOERR) goto ncfail;
+        /* A coordinate attribute is a scalar string. Keep the first element
+           for compatibility, but diagnose discarded additional strings. */
+        if (count > 1) {
+          snprintf(pout,1255,"Warning: SDF attribute %s:%s is a string array; using its first string\n",
+                   varname,attname);
+          gaprnt(1,pout);
+        }
+        length = strings[0] ? strlen(strings[0])+1 : 1;
+        if (length > INT_MAX) goto nomem;
+        value = galloc(length,"ncstring");
+        if (!value) goto nomem;
+        memcpy(value,strings[0] ? strings[0] : "",length);
+        nc_free_string(count,strings);
+        gree(strings,"ncstrings");
+        strings = NULL;
+        storedtype = NC_CHAR;
+        break;
+      default: status = nc_get_att_double(cdfid,varid,attname,value); break;
+    }
+    if (status != NC_NOERR) goto ncfail;
+    newattrib = galloc(sizeof(*newattrib),"ncattrnode");
+    if (!newattrib) goto nomem;
+    memset(newattrib,0,sizeof(*newattrib));
+    strcpy(newattrib->varname,varname);
+    strcpy(newattrib->name,attname);
+    newattrib->len = (gaint)length;
+    newattrib->nctype = (gaint)storedtype;
+    newattrib->value = value;
+    if (attrib) attrib->next = newattrib;
+    else pfi->attr = newattrib;
+    attrib = newattrib;
+    value = NULL;
+  }
+  return Success;
 
+nomem:
+  gaprnt(0,"SDF metadata error: attribute allocation failed or size is too large\n");
+  goto fail;
+ncfail:
+  handle_error(status);
+  gaprnt(0,"SDF metadata error: unable to read NetCDF attribute\n");
+fail:
+  if (value) gree(value,"ncattrfail");
+  if (strings) {
+    nc_free_string(count,strings);
+    gree(strings,"ncstrfail");
+  }
+  return Failure;
+#else
+  return Failure;
+#endif
+}
 
