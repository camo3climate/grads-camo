+
+static char *txtw_dim_name(gaint dim) {
+  if (dim==0) return "lon";
+  if (dim==1) return "lat";
+  if (dim==2) return "lev";
+  if (dim==3) return "time";
+  if (dim==4) return "ens";
+  return "coord";
+}
+
+static void txtw_coord(char *buf, size_t buflen, gaint dim, gadouble gval,
+                       gadouble *vals, gadouble (*conv)(gadouble *, gadouble)) {
+struct dt dtim;
+gadouble val;
+
+  if (dim==3 && vals) {
+    gr2t(vals,gval,&dtim);
+    snprintf(buf,buflen,"%04d-%02d-%02dT%02d:%02d",
+             dtim.yr,dtim.mo,dtim.dy,dtim.hr,dtim.mn);
+  }
+  else {
+    if (conv) val = conv(vals,gval);
+    else val = gval;
+    snprintf(buf,buflen,"%g",val);
+  }
+}
+
+gaint txtwrite (char *cmd, char *com, struct gacmn *pcm) {
+struct gastat *pst=NULL;
+struct gagrid *pgr=NULL;
+FILE *fp=NULL;
+char *tok,*expr,*filename;
+char fname[1024],undefbuf[1024],coord1[80],coord2[80],sep[2],*undefstr;
+gaint header=0,rc=1,i,j,idx,dimcnt,toklen;
+gadouble gval1,gval2;
+
+  undefstr = "undef";
+  sep[0] = ' '; sep[1] = '\0';
+
+  tok = nxtwrd(cmd);
+  if (tok==NULL) goto syntax;
+  while (cmpwrd("-csv",tok) || cmpwrd("-header",tok) || cmpwrd("-undef",tok)) {
+    if (cmpwrd("-csv",tok)) {
+      sep[0] = ',';
+    }
+    else if (cmpwrd("-header",tok)) {
+      header = 1;
+    }
+    else if (cmpwrd("-undef",tok)) {
+      tok = nxtwrd(tok);
+      if (tok==NULL) goto syntax;
+      toklen = wrdlen(tok);
+      if ((size_t)toklen >= sizeof(undefbuf)) goto syntax;
+      memcpy(undefbuf,com+(tok-cmd),toklen);
+      undefbuf[toklen] = '\0';
+      undefstr = undefbuf;
+    }
+    tok = nxtwrd(tok);
+    if (tok==NULL) goto syntax;
+  }
+
+  filename = tok;
+  toklen = wrdlen(filename);
+  if ((size_t)toklen >= sizeof(fname)) goto syntax;
+  memcpy(fname,com+(filename-cmd),toklen);
+  fname[toklen] = '\0';
+  expr = nxtwrd(filename);
+  if (expr==NULL) goto syntax;
+
+  pst = getpst(pcm);
+  if (pst==NULL) goto cleanup;
+  if (gaexpr(expr,pst)) goto cleanup;
+  if (pst->type!=1 || pst->result.pgr==NULL) {
+    gaprnt(0,"TXTWRITE error: result must be grid data\n");
+    goto cleanup;
+  }
+  pgr = pst->result.pgr;
+  dimcnt = 0;
+  if (pgr->idim>-1) dimcnt++;
+  if (pgr->jdim>-1) dimcnt++;
+  if (dimcnt<1 || dimcnt>2) {
+    gaprnt(0,"TXTWRITE error: result must be a 1-D or 2-D grid\n");
+    goto cleanup;
+  }
+
+  fp = fopen(fname,"w");
+  if (fp==NULL) {
+    snprintf(pout,1255,"TXTWRITE error: unable to open %s\n",fname);
+    gaprnt(0,pout);
+    goto cleanup;
+  }
+
+  if (header) {
+    if (dimcnt==1)
+      fprintf(fp,"%s%svalue\n",txtw_dim_name(pgr->idim),sep);
+    else
+      fprintf(fp,"%s%s%s%svalue\n",txtw_dim_name(pgr->idim),sep,
+              txtw_dim_name(pgr->jdim),sep);
+  }
+
+  if (dimcnt==1) {
+    for (i=0; i<pgr->isiz; i++) {
+      gval1 = (gadouble)(pgr->dimmin[pgr->idim] + i);
+      txtw_coord(coord1,sizeof(coord1),pgr->idim,gval1,pgr->ivals,pgr->igrab);
+      if (*(pgr->umask+i))
+        fprintf(fp,"%s%s%.15g\n",coord1,sep,*(pgr->grid+i));
+      else
+        fprintf(fp,"%s%s%s\n",coord1,sep,undefstr);
+    }
+  }
+  else {
+    for (j=0; j<pgr->jsiz; j++) {
+      gval2 = (gadouble)(pgr->dimmin[pgr->jdim] + j);
+      txtw_coord(coord2,sizeof(coord2),pgr->jdim,gval2,pgr->jvals,pgr->jgrab);
+      for (i=0; i<pgr->isiz; i++) {
+        idx = j*pgr->isiz + i;
+        gval1 = (gadouble)(pgr->dimmin[pgr->idim] + i);
+        txtw_coord(coord1,sizeof(coord1),pgr->idim,gval1,pgr->ivals,pgr->igrab);
+        if (*(pgr->umask+idx))
+          fprintf(fp,"%s%s%s%s%.15g\n",coord1,sep,coord2,sep,*(pgr->grid+idx));
+        else
+          fprintf(fp,"%s%s%s%s%s\n",coord1,sep,coord2,sep,undefstr);
+      }
+    }
+  }
+
+  if (fflush(fp)!=0 || ferror(fp)) {
+    snprintf(pout,1255,"TXTWRITE error while writing %s\n",fname);
+    gaprnt(0,pout);
+    goto cleanup;
+  }
+  snprintf(pout,1255,"Wrote text data to %s\n",fname);
+  gaprnt(2,pout);
+  rc = 0;
+
+cleanup:
+  if (fp) fclose(fp);
+  if (pst) {
+    gafree(pst);
+    gree(pst,"txtw0");
+  }
+  return rc;
+
+syntax:
+  gaprnt(0,"TXTWRITE error: syntax is txtwrite [-csv] [-header] [-undef value] file expr\n");
+  return 1;
+}
