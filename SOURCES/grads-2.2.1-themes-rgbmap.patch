+static gaint gacamo_copyword (char *src, char *dst, gaint dstlen) {
+gaint i;
+
+  if (src==NULL || dst==NULL || dstlen<1) return(0);
+  for (i=0; src[i] && src[i]!=' ' && src[i]!='\t' && i<dstlen-1; i++) dst[i] = src[i];
+  dst[i] = '\0';
+  return(i);
+}
+
+static gaint gacamo_has_reverse_suffix (char *name) {
+size_t len;
+
+  if (name==NULL) return(0);
+  len = strlen(name);
+  if (len<3) return(0);
+  if (name[len-2]!='_') return(0);
+  if (name[len-1]=='r' || name[len-1]=='R') {
+    name[len-2] = '\0';
+    return(1);
+  }
+  return(0);
+}
